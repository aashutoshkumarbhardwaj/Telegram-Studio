# Heyaaashu Studio — Environment Configuration Template
# Copy this file to .env and configure your production values:
# cp .env.example .env

# Telegram Bot Credentials (Required for publishing & bot polling)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Studio Web Authentication & Session Secret (Required for production)
STUDIO_AUTH_TOKEN=
SESSION_SECRET=

# AI Research & LLM Key (Optional for heuristic fast-path, recommended for full enrichment)
GEMINI_API_KEY=

# Database Configuration (Docker defaults to persistent named volume /app/data/studio.db)
DATABASE_PATH=/app/data/studio.db

# Frontend API URL (Default relative path for Nginx reverse proxy)
VITE_API_URL=/api

# CORS Allowed Origins (Comma-separated, e.g. http://localhost,https://studio.heyaaashu.com)
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
